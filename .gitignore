# --- user-added ---
/tmp
/out-tsc
/.pnp
.pnp.js
.vscode/*

# --- dependencies ---
node_modules/
.pnpm-store/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# --- build output ---
dist/
build/
lib/
*.tsbuildinfo
.turbo/
.tsup/

# --- test output ---
coverage/
.vitest-cache/
.nyc_output/

# --- logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- environment / secrets ---
.env
.env.*
!.env.example

# --- Amplify Gen 2 generated artifacts ---
# These are rebuilt on every sandbox deploy; no reason to commit them
# and the CDK asset bundles can be 100MB+.
.amplify/
amplify_outputs.json
amplify_outputs*.json
amplifyconfiguration*.json
aws-exports.*

# --- OS cruft ---
.DS_Store
Thumbs.db
Desktop.ini

# --- editors ---
.idea/
*.swp
*.swo
.history/

# --- changesets runtime state ---
# (keep .changeset/config.json and *.md; ignore only transient state)
.changeset/*.json
!.changeset/config.json
