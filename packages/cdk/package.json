{
  "name": "@lapinsoft/data-migrations-cdk",
  "version": "1.0.0-alpha.1",
  "description": "Amplify Gen 2 backend integration for amplify-migrations",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && node --no-warnings --import @swc-node/register/esm-register --test test/*.test.ts test/*.pkgtest.ts"
  },
  "dependencies": {
    "@lapinsoft/data-migrations-core": "workspace:*",
    "esbuild": "^0.28.0"
  },
  "peerDependencies": {
    "aws-cdk-lib": ">=2.140.0",
    "constructs": ">=10.0.0"
  },
  "devDependencies": {
    "@swc-node/register": "^1.10.0",
    "@types/node": "^20.14.0",
    "aws-cdk-lib": "^2.164.0",
    "constructs": "^10.3.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  },
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "peerDependenciesMeta": {
    "aws-cdk-lib": { "optional": false },
    "constructs": { "optional": false }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peterlapin/amplify-migrations.git",
    "directory": "packages/cdk"
  },
  "homepage": "https://github.com/peterlapin/amplify-migrations#readme",
  "bugs": { "url": "https://github.com/peterlapin/amplify-migrations/issues" },
  "keywords": ["amplify", "aws", "cdk", "dynamodb", "migrations", "gen2"],
  "engines": { "node": ">=22" }
}
